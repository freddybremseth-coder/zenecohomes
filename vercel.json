{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/saved-search-alerts",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/informasjonsm%C3%B8te",
      "destination": "/informasjonsmote",
      "permanent": true
    }
  ]
}
